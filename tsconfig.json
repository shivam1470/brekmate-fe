{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "vitest/globals", "node"]
  },
  "include": [
    "packages/**/*.ts",
    "apps/staff/src/**/*.tsx",
    "apps/staff/src/**/*.ts",
    "test/**/*.ts",
    "test/**/*.tsx",
    "scripts/**/*.ts"
  ],
  "exclude": ["test/native.test.tsx", "test/*.native.test.tsx"]
}
